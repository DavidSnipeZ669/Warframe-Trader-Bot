# Warframe Market API v2
# Get your JWT token by logging in at https://warframe.market
WARFRAME_MARKET_JWT=your_jwt_token_here

# Platform: pc, ps4, xbox, switch, mobile (default: pc)
WARFRAME_PLATFORM=pc

# Crossplay: true/false - Include cross-play orders from other platforms (default: true)
WARFRAME_CROSSPLAY=true

# Discord Webhook URL for notifications
# Create a webhook in your Discord server settings
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# SMS/Text Notifications (optional)
# Twilio credentials for SMS notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
YOUR_PHONE_NUMBER=+1234567890

# Trading Configuration
# Minimum profit percentage to trigger notifications (default: 5)
MIN_PROFIT_PERCENTAGE=5

# Maximum platinum to use for buy orders
MAX_PLATINUM_FOR_ORDERS=500

# How often to check for price updates (in minutes)
PRICE_CHECK_INTERVAL=5

# Enable/Disable auto-listing (true/false)
AUTO_LISTING_ENABLED=true

# Undercut amount for sell orders (default: 1)
SELL_UNDERCUT_AMOUNT=1

# Overcut amount for buy orders (default: 1)
BUY_OVERCUT_AMOUNT=1
