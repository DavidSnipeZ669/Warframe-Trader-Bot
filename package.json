{
  "name": "warframe-trader-bot",
  "version": "1.0.0",
  "description": "Warframe market automation bot with inventory management and notification features",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "start:cli": "node src/index.js start",
    "help": "node src/index.js help",
    "add": "node src/index.js add",
    "list": "node src/index.js list",
    "analyze": "node src/index.js analyze",
    "search": "node src/index.js search",
    "scan": "node src/index.js scan",
    "prices": "node src/index.js prices",
    "status": "node src/index.js status",
    "test": "jest",
    "lint": "eslint src/ tests/",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "warframe",
    "trading",
    "automation",
    "warframe-market",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "node-cron": "^4.2.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "electron": "^39.2.4",
    "eslint": "^9.39.1",
    "jest": "^30.2.0"
  },
  "build": {
    "appId": "com.warframe.trader-bot",
    "productName": "Warframe Trader Bot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "app/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "app/icon.png"
    }
  }
}
